# OpenAI API (required)
OPENAI_API_KEY=sk-...

# Google Custom Search (optional, for SearchAgent)
GOOGLE_API_KEY=AIza...
GOOGLE_CX=...

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/lumencode

# JWT Secret for authentication
JWT_SECRET=your-secret-key-change-this

# Email Configuration (for user registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Admin Key (for admin endpoints)
ADMIN_KEY=your-admin-key-change-this
