# OpenAI API (required)
OPENAI_API_KEY=sk-...

# Google Custom Search (optional, for SearchAgent)
GOOGLE_API_KEY=AIza...
GOOGLE_CX=...

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/lumencode

# JWT Secret for authentication (REQUIRED in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=1h

# Email Configuration (for user registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# CORS — comma-separated allowlist. REQUIRED in production.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# Body size limit (default 256kb)
BODY_LIMIT=256kb

# Admin Key (for admin endpoints; REQUIRED in production)
ADMIN_KEY=your-admin-key-change-this

# Optional: require a Bearer token on LLM-backed routes (anonymous callers otherwise get LLM_RATE_LIMIT_MAX per 15 min per IP)
REQUIRE_AUTH_FOR_LLM=false
LLM_RATE_LIMIT_MAX=30
# Required in production: stable signing key (WIF) so signatures keep one identity across restarts and replicas
PLATFORM_PRIVATE_KEY=
